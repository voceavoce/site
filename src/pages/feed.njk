---
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ lang | routeUrl }}feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
  <title>{{ site.name }}</title>
  <subtitle>{{ 'home.description' | t(lang) }}</subtitle>
  <id>{{ (lang | routeUrl) | absUrl }}</id>
  <link rel="self" type="application/atom+xml" href="{{ (lang | routeUrl) | absUrl }}feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ (lang | routeUrl) | absUrl }}"/>
  <updated>{{ catalog.ultimi[0].ultimaUscita if catalog.ultimi.length else site.buildTime }}</updated>
  <author><name>{{ site.name }}</name><uri>{{ site.url }}/</uri></author>
{%- for p in catalog.ultimi | slice30 %}
  <entry>
    <title>{{ p.titolo }}{% if p.compositore %} – {{ p.compositore.nome }}{% endif %}</title>
    <id>{{ (lang | routeUrl('pieces', p.slug)) | absUrl }}</id>
    <link rel="alternate" type="text/html" href="{{ (lang | routeUrl('pieces', p.slug)) | absUrl }}"/>
    <updated>{{ p.ultimaUscita }}</updated>
    <summary>{{ p | pieceDescription(lang) }}</summary>
  </entry>
{%- endfor %}
</feed>
