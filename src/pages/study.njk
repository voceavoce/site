---
layout: layouts/base.njk
pagination:
  data: studio.schede
  size: 1
  alias: entry
eleventyExcludeFromCollections: true
---
{#- Player di studio (Fase 2, P3+P4): una pagina per (brano x lingua). Dati in study.11tydata.js. Tutto il codice e' in /assets/js/study/ -#}
{%- set tracks = item.manifest.tracce -%}
{%- set firstVoice = piece.voci[0] if piece else null -%}
<div class="wrap study" data-study>
  <header class="study__head">
    <h1>{{ 'study.h1' | tv(lang, { title: pieceTitle }) }}</h1>
    <p class="study__meta">
      {%- if piece %}<a href="{{ lang | routeUrl('pieces', piece.slug) }}">{{ 'study.back' | t(lang) }}</a>
      {%- else %}{{ item.manifest.compositore.nome }}{% endif %}
    </p>
    {%- if item.test %}<p class="study__test">{{ 'study.testNotice' | t(lang) }}</p>{% endif %}
  </header>

  <p class="study__status" role="status" data-status></p>
  <p class="study__error" role="alert" data-error hidden></p>
  <noscript><p class="study__error">{{ 'study.noscript' | t(lang) }}</p></noscript>

  <div class="study__grid">
    <section class="study__score" aria-labelledby="study-score-h">
      <div class="study__bar">
        <h2 id="study-score-h">{{ 'study.score' | t(lang) }}</h2>
        <div class="study__tools">
          <button type="button" class="tool" data-zoom-out disabled aria-label="{{ 'study.zoomOut' | t(lang) }}"><span aria-hidden="true">A−</span></button>
          <button type="button" class="tool" data-zoom-in disabled aria-label="{{ 'study.zoomIn' | t(lang) }}"><span aria-hidden="true">A+</span></button>
          <button type="button" class="tool tool--text" data-score-invert aria-pressed="false">{{ 'study.invert' | t(lang) }}</button>
          <button type="button" class="tool tool--text" data-loop-pick data-feature="loop" aria-pressed="false" aria-describedby="study-pick-hint" data-needs-audio disabled>{{ 'study.pick' | t(lang) }}</button>
        </div>
      </div>
      <section class="score-scroll" data-score tabindex="0" aria-label="{{ 'study.scoreLabel' | tv(lang, { title: pieceTitle }) }}" data-label="{{ 'study.scoreLabel' | tv(lang, { title: pieceTitle }) }}"></section>
      <p id="study-pick-hint" class="study__hint" data-feature="loop">{{ 'study.pickHint' | t(lang) }}</p>
    </section>

    <div class="study__side">
      <section class="panel" data-loop data-feature="loop" aria-labelledby="study-loop-h">
        <h2 id="study-loop-h">{{ 'study.loop' | t(lang) }}</h2>
        <div class="loop-row">
          <label class="field"><span>{{ 'study.loopFrom' | t(lang) }}</span>
            <select data-loop-from data-needs-audio disabled></select></label>
          <label class="field"><span>{{ 'study.loopTo' | t(lang) }}</span>
            <select data-loop-to data-needs-audio disabled></select></label>
        </div>
        <button type="button" class="tool tool--wide" data-loop-toggle aria-pressed="false" data-needs-audio disabled>{{ 'study.loopBtn' | t(lang) }}</button>
      </section>

      <section class="panel" data-mixer data-feature="mixer" aria-labelledby="study-mixer-h">
        <h2 id="study-mixer-h">{{ 'study.mixer' | t(lang) }}</h2>
        <p class="study__hint">{{ 'study.mixerHint' | t(lang) }}</p>
        <ul class="mix">
          {%- for tr in tracks %}
          {%- set vname = tr.voce | voiceName(lang) %}
          <li class="mix__row" data-track="{{ tr.chiave }}">
            <span class="mix__name">{% if tr.voce.length <= 3 %}<span class="voice-opt__code" aria-hidden="true">{{ tr.voce }}</span> {% endif %}{{ vname }}</span>
            <input type="range" class="mix__vol" min="0" max="100" step="5" value="100" data-volume data-needs-audio disabled aria-label="{{ 'study.volume' | tv(lang, { voice: vname }) }}">
            <output class="mix__out" data-volume-out>100%</output>
            <button type="button" class="tool" data-mute aria-pressed="false" aria-label="{{ 'study.muteOf' | tv(lang, { voice: vname }) }}" data-needs-audio disabled><span aria-hidden="true">{{ 'study.mute' | t(lang) }}</span></button>
            <button type="button" class="tool" data-solo aria-pressed="false" aria-label="{{ 'study.soloOf' | tv(lang, { voice: vname }) }}" data-needs-audio disabled><span aria-hidden="true">{{ 'study.solo' | t(lang) }}</span></button>
          </li>
          {%- endfor %}
        </ul>
        <div class="myvoice">
          <label class="field"><span>{{ 'study.myVoiceSelect' | t(lang) }}</span>
            <select data-myvoice-select data-needs-audio disabled>
              {%- for tr in tracks %}{% if tr.tipo != "accompagnamento" %}
              <option value="{{ tr.chiave }}">{{ tr.voce | voiceName(lang) }}</option>
              {%- endif %}{% endfor %}
            </select></label>
          <button type="button" class="tool tool--text" data-myvoice data-needs-audio disabled aria-describedby="study-myvoice-hint">{{ 'study.myVoice' | t(lang) }}</button>
        </div>
        <p id="study-myvoice-hint" class="study__hint">{{ 'study.myVoiceHint' | t(lang) }}</p>
      </section>

      {%- if firstVoice %}
      <section class="panel player" data-player aria-labelledby="study-video-h"
        data-title="{{ 'piece.iframeTitle' | tv(lang, { title: piece.titolo, voice: '{voice}' }) }}">
        <h2 id="study-video-h">{{ 'study.video' | t(lang) }}</h2>
        <fieldset class="voice-picker" hidden>
          <legend>{{ 'piece.pick' | t(lang) }}</legend>
          {%- for v in piece.voci %}
          <label class="voice-opt">
            <input type="radio" name="voce" value="{{ v.voce }}" data-id="{{ v.video_id }}" data-name="{{ v.voce | voiceName(lang) }}"{% if loop.first %} checked{% endif %}>
            {%- if v.voce.length <= 3 %}<span class="voice-opt__code" aria-hidden="true">{{ v.voce }}</span>{% endif %}
            <span>{{ v.voce | voiceName(lang) }}</span>
          </label>
          {%- endfor %}
        </fieldset>
        <div class="player__frame">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ firstVoice.video_id }}" width="560" height="315"
            title="{{ 'piece.iframeTitle' | tv(lang, { title: piece.titolo, voice: (firstVoice.voce | voiceName(lang)) }) }}"
            loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <ul class="voice-links" data-links>
          {%- for v in piece.voci %}
          <li><a href="https://www.youtube.com/watch?v={{ v.video_id }}" rel="noopener">{{ 'piece.watchVoice' | tv(lang, { voice: (v.voce | voiceName(lang)) }) }}</a></li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      {%- if site.donazioni %}
      <p class="study__support"><a class="btn btn--ghost" href="{{ site.donazioni }}" rel="noopener">{{ 'study.support' | t(lang) }}</a></p>
      {%- endif %}
    </div>
  </div>
</div>

<div class="transport" role="group" aria-label="{{ 'study.transport' | t(lang) }}">
  <div class="transport__row">
    <button type="button" class="transport__play" data-play data-needs-audio disabled aria-pressed="false">
      <svg class="ico-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg>
      <svg class="ico-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 4.5h4.5v15H6zM13.5 4.5H18v15h-4.5z" fill="currentColor"/></svg>
      <span data-play-label>{{ 'study.play' | t(lang) }}</span>
    </button>
    <p class="transport__time"><span data-time>0:00</span> / <span data-total>0:00</span></p>
    <input type="range" class="transport__seek" data-seek data-needs-audio disabled min="0" max="{{ item.manifest.durata_sec }}" step="0.1" value="0" aria-label="{{ 'study.position' | t(lang) }}">
  </div>
  <div class="transport__row transport__row--2">
    <div class="transport__speed" data-feature="tempo"><label for="study-speed">{{ 'study.speed' | t(lang) }}</label>
      <input type="range" id="study-speed" data-speed data-needs-audio disabled min="50" max="100" step="5" value="100" aria-valuetext="100%">
      <output data-speed-out for="study-speed">100%</output></div>
    <button type="button" class="tool tool--text" data-loop-toggle data-feature="loop" aria-pressed="false" data-needs-audio disabled>{{ 'study.loopShort' | t(lang) }}</button>
  </div>
</div>
<script type="application/json" id="study-data">{{ studyData | jsonSafe | safe }}</script>
