{%- set canonicalPath = lang | routeUrl(routeSection, routeSlug) -%}
{%- set canonical = canonicalPath | absUrl -%}
{%- set pageTitle = titleFull or (title if (isHome or not title) else (title ~ " · " ~ site.name)) -%}
{%- set ogPiece = catalog.perSlug[routeSlug] if (routeSection == "pieces" and routeSlug) else null -%}
{%- set og = ogPiece | pageOg -%}
{%- set ogImg = og.image if (ogPiece or not ogImage) else (ogImage | absUrl) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description }}">
{%- if noindex %}
<meta name="robots" content="noindex, follow">
{%- endif %}
<link rel="canonical" href="{{ canonical }}">
{%- for alt in routeSection | altUrls(routeSlug) %}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url | absUrl }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ (site.defaultLang | routeUrl(routeSection, routeSlug)) | absUrl }}">
<meta name="theme-color" content="#121a2c">
<meta property="og:type" content="{{ og.type }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.locales[lang] }}">
{%- for l in site.langs %}{% if l != lang %}
<meta property="og:locale:alternate" content="{{ site.locales[l] }}">
{%- endif %}{% endfor %}
<meta property="og:image" content="{{ ogImg }}">
{%- if not ogImage or ogPiece %}
<meta property="og:image:width" content="{{ og.width }}">
<meta property="og:image:height" content="{{ og.height }}">
{%- endif %}
<meta property="og:image:alt" content="{{ site.name }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImg }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ (lang | routeUrl) | absUrl }}feed.xml">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="stylesheet" href="/assets/css/main.css">
<script>try{var t=localStorage.getItem("vav_theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<script src="/assets/js/theme.js" defer></script>
{%- if routeSection == "pieces" and routeSlug %}
<script src="/assets/js/player.js" defer></script>
{%- endif %}
<script type="application/ld+json">{{ lang | siteLd | safe }}</script>
{%- if ogPiece %}
<script type="application/ld+json">{{ ogPiece | pieceLd(lang) | safe }}</script>
{%- endif %}
{#- Punto di innesto per il CMP (TCF 2.2) se si attivano gli annunci: vedi docs/plan.md #}
</head>
<body>
<a class="skip-link" href="#main">{{ 'skip' | t(lang) }}</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ lang | routeUrl }}" aria-label="{{ 'home.label' | t(lang) }}">
      <img src="/assets/img/avatar.png" alt="" width="40" height="40">
      <span aria-hidden="true">VOCE <span class="a">a</span> VOCE</span>
    </a>
    <nav class="main-nav" aria-label="{{ 'nav.label' | t(lang) }}">
      <ul>
        {%- set navItems = [["choir","coro"],["arias","arie"],["methods","metodi"],["composers","compositori"],["seasons","stagioni"],["search","cerca"]] %}
        {%- for item in navItems %}
        <li><a href="{{ lang | routeUrl(item[0]) }}"{% if routeSection == item[0] %} aria-current="page"{% endif %}>{{ ('nav.' ~ item[1]) | t(lang) }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="header-tools">
      {% include "components/lang-switch.njk" %}
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" hidden>
        <span class="ico" aria-hidden="true"></span><span class="lbl">{{ 'theme.toggle' | t(lang) }}</span>
      </button>
    </div>
  </div>
</header>
{% if breadcrumbs %}<div class="wrap">{% include "components/breadcrumbs.njk" %}</div>{% endif %}
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <div>
      <h2>{{ 'footer.follow' | t(lang) }}</h2>
      <ul class="footer-list">
        {%- for key, href in site.social %}
        <li><a href="{{ href }}" rel="me noopener">{{ ('social.' ~ key) | t(lang) }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <h2>{{ 'footer.contact' | t(lang) }}</h2>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <div>{% include "components/info-links.njk" %}</div>
    <p class="fine">© {{ site.buildTime.slice(0, 4) }} {{ 'footer.rights' | t(lang) }} · {{ 'footer.note' | t(lang) }}</p>
  </div>
</footer>
</body>
</html>
