{#- Griglia di card. Variabili: pieces (brani), asPath (elenco numerato), lang -#}
{%- if asPath %}{% set showNo = true %}{% endif %}
<{{ 'ol' if asPath else 'ul' }} class="grid-auto piece-grid plain{% if asPath %} piece-grid--path{% endif %}" role="list">
  {%- for piece in pieces %}
  <li>{% include "components/card.njk" %}</li>
  {%- endfor %}
</{{ 'ol' if asPath else 'ul' }}>
