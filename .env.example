# Configurazione locale del sito (copia questo file e chiamala .env.local).
# Tutti i valori qui sono FITTIZI. Le credenziali vere NON vanno in questo file:
# mettile in .env.local (ignorato da git) oppure nella config di rclone del profilo utente
# (~/.config/rclone/rclone.conf). Lo script upload-audio.mjs legge prima process.env, poi .env.local.

# Cartella LOCALE degli audio (fuori dal repo). Relativa alla radice del repo oppure assoluta.
# Struttura: <slug>/<versione>/<voce>.opus e .mp3. Non entra mai in git.
VOCEAVOCE_AUDIO_DIR=../aivideocreator/runtime/audio_sito

# Base URL per il player in sviluppo (scripts/serve-audio.mjs, porta VOCEAVOCE_AUDIO_PORT, default 8787).
VOCEAVOCE_AUDIO_BASE=http://localhost:8787

# Porta del server di sviluppo degli audio.
VOCEAVOCE_AUDIO_PORT=8787

# Cloudflare R2 (caricamento a mano con scripts/upload-audio.mjs).
# ID account: 32 caratteri esadecimali, lo trovi nella dashboard Cloudflare.
R2_ACCOUNT_ID=00000000000000000000000000000000
# Token API con permesso Object Read & Write limitato al solo bucket.
R2_ACCESS_KEY_ID=example
R2_SECRET_ACCESS_KEY=example
R2_BUCKET=voceavoce-audio
# URL del Worker workers.dev (il bucket e' privato). Serve allo script di caricamento per verificare
# con HEAD che i file rispondano dal Worker. Sostituiscilo con l'URL mostrato da `wrangler deploy`.
R2_PUBLIC_BASE=https://voceavoce-audio.CAMBIAMI.workers.dev

# Nome del remote rclone. Se R2_ACCOUNT_ID, R2_ACCESS_KEY_ID e R2_SECRET_ACCESS_KEY sono tutti
# impostati, lo script crea il remote "al volo" con questo nome; altrimenti usa un remote
# gia' presente nella config di rclone con questo nome (e le credenziali R2_* possono restare vuote).
RCLONE_REMOTE=r2
